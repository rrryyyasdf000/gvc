import tkinter as tk
import math
import time
import random

class HeartAnimation:
    def __init__(self, name):
        self.window = tk.Tk()
        self.window.title("❤️ 给特别的你 ❤️")
        self.canvas = tk.Canvas(self.window, width=800, height=600, bg='black')
        self.canvas.pack()
        self.name = name
        self.hearts = []
        self.messages = []
        self.running = True
        self.setup_ui()

    def heart_function(self, t, scale=10):
        """生成爱心形状的坐标"""
        x = 16 * (math.sin(t)**3)
        y = 13 * math.cos(t) - 5*math.cos(2*t) - 2*math.cos(3*t) - math.cos(4*t)
        return x * scale, y * scale

    def create_heart(self):
        """创建新的爱心"""
        color = random.choice(['#FF69B4', '#FF1493', '#FF00FF', '#FFB6C1'])
        x = random.randint(100, 700)
        y = 600
        heart = self.canvas.create_text(x, y, text='❤', font=('Arial', 30), fill=color)
        return {'id': heart, 'speed': random.uniform(1.5, 3.0), 'scale': random.uniform(0.8, 1.5)}

    def create_message(self):
        """创建浮动文字"""
        messages = [
            f"{self.name}, 你是我唯一的心动",
            "你的微笑照亮我的世界",
            "余生请多指教",
            "I Love You 3000",
            "You complete me"
        ]
        msg = random.choice(messages)
        x = random.randint(50, 750)
        color = random.choice(['#FFFFFF', '#FFD700', '#00FF00', '#00FFFF'])
        text = self.canvas.create_text(x, 600, text=msg, 
                                     font=('楷体', 18, 'bold'),
                                     fill=color,
                                     anchor='center')
        return text

    def animate_hearts(self):
        """更新爱心动画"""
        for heart in self.hearts[:]:
            self.canvas.move(heart['id'], 0, -heart['speed'])
            pos = self.canvas.coords(heart['id'])
            if pos[1] < -50:
                self.canvas.delete(heart['id'])
                self.hearts.remove(heart)
        
        if random.random() < 0.08:
            self.hearts.append(self.create_heart())

    def animate_messages(self):
        """更新文字动画"""
        for msg in self.messages[:]:
            self.canvas.move(msg, 0, -1)
            pos = self.canvas.coords(msg)
            if pos[1] < -20:
                self.canvas.delete(msg)
                self.messages.remove(msg)
        
        if random.random() < 0.05:
            self.messages.append(self.create_message())

    def draw_central_heart(self):
        """绘制中心动态爱心"""
        self.canvas.delete('central')
        t = time.time()
        points = []
        for i in range(100):
            angle = math.pi * 2 * i / 100
            x, y = self.heart_function(angle, 15)
            points.append(400 + x)
            points.append(300 + y + 10*math.sin(t*3 + angle*2))
        
        self.canvas.create_polygon(points, fill='#FF4040', outline='#FF1493', tag='central')

    def show_main_message(self):
        """显示主表白文字"""
        text = f"亲爱的{self.name}：\n"
        text += "从遇见你的那一刻起\n"
        text += "我的心跳便不再受控\n"
        text += "你是我代码中最完美的算法\n"
        text += "是我生命里不可或缺的依赖\n"
        text += "往后余生，可否让我\n"
        text += "做你永远的守护进程？"
        
        self.canvas.create_text(400, 300, text=text, 
                              font=('华文行楷', 24), 
                              fill='#FFD700',
                              justify='center',
                              tag='main_text')

    def setup_ui(self):
        """初始化界面元素"""
        # 添加退出按钮
        btn = tk.Button(self.window, text="点击接收我的心意", 
                       command=self.show_main_message,
                       font=('宋体', 14),
                       bg='#FF1493',
                       fg='white')
        self.canvas.create_window(400, 550, window=btn)

    def update(self):
        """主更新循环"""
        if not self.running:
            return
        
        self.canvas.delete('hearts')
        self.animate_hearts()
        self.animate_messages()
        self.draw_central_heart()
        self.window.after(30, self.update)

    def run(self):
        """运行程序"""
        self.update()
        self.window.mainloop()

if __name__ == "__main__":
    your_name = input("请输入你心仪之人的名字：")
    animation = HeartAnimation(your_name)
    animation.run()